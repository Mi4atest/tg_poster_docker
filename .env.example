# =============================================================================
#  tg_poster — переменные окружения
# =============================================================================
# Принцип: в .env держим только «загрузочный» минимум. Остальное (каналы, бэкап,
# отчёты, подписи, часть токенов) настраивается в самом боте: «⚙️ Настройки».
# При первом старте значения из этого .env один раз импортируются в БД (bootstrap),
# секреты — в зашифрованном виде. После этого .env можно почистить.
# -----------------------------------------------------------------------------

# --- ОБЯЗАТЕЛЬНО (без этого бот не стартует) ---------------------------------
# Токен основного Telegram-бота управления (@BotFather)
TELEGRAM_BOT_TOKEN=
# ID пользователей Telegram, кому разрешён доступ к боту (через запятую)
ALLOWED_USER_IDS=
# Ключ шифрования секретов в БД. Сгенерировать: openssl rand -hex 32
# ВАЖНО: задаётся один раз. Смена ключа сделает ранее сохранённые секреты нечитаемыми.
MASTER_KEY=

# --- База данных (используется docker-compose и приложением) -----------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tg_poster
DATABASE_URL=postgresql://postgres:postgres@db:5432/tg_poster

# --- Токены площадок ----------------------------------------------------------
# Пока читаются из .env (постепенно переносятся в «Настройки → Интеграции»).
# Можно оставить пустыми и заполнить в меню бота (хранятся зашифрованными).
VK_APP_ID=
VK_APP_SECRET=
VK_ACCESS_TOKEN=
VK_MARKET_ACCESS_TOKEN=
VK_GROUP_ID=
# Defaults only (seed for Settings). Runtime toggles:
# Настройки → Публикация и интервалы → VK
VK_UPLOAD_STRICT_MODE=true
VK_WALL_REQUIRES_MARKET=true
VK_WALL_ATTACH_MARKET=true

INSTAGRAM_GRAPH_USER_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_APP_ID=
INSTAGRAM_GRAPH_APP_SECRET=
# Legacy-вход в Instagram (необязательно, если используется Graph API)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

MAX_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Настраивается в боте «⚙️ Настройки», в .env НЕ требуется:
#   • Каналы:        TELEGRAM_CHANNEL_ID, MAX_CHANNEL_ID
#   • Отчёты/списки: VK_REPORT_USER_IDS, AVAILABILITY_MESSAGE_IDS,
#                    USED_PRODUCTS_LIST_MESSAGE_IDS
#   • Бэкап:         BACKUP_BOT_TOKEN, BACKUP_CHAT_ID, BACKUP_PROJECT_NAME, BACKUP_MEDIA
#   • Подписи/контакты: SIGNATURE_*, TELEGRAM_CONTACT_*
#   • Каталог б/у в постах:
#       TELEGRAM_USED_CATALOG_BUTTON_ENABLED=true|false
#       TELEGRAM_USED_CATALOG_URL=https://t.me/...
#       VK_USED_CATALOG_URL=https://vk.cc/...
# -----------------------------------------------------------------------------
