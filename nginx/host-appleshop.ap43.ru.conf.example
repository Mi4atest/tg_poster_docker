# Хостовый nginx (НЕ контейнер tg_poster_nginx).
# Скопировать на сервер 147.45.117.60, например:
#   /etc/nginx/sites-available/appleshop.ap43.ru
#   ln -s .../sites-available/appleshop.ap43.ru .../sites-enabled/
#
# DNS: A-запись appleshop.ap43.ru → 147.45.117.60
# Docker: в docker-compose.yml у nginx: "127.0.0.1:8080:80"

# HTTP — только ACME и редирект на HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name appleshop.ap43.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — только OAuth callback (остальное не светим наружу)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name appleshop.ap43.ru;

    ssl_certificate     /etc/letsencrypt/live/appleshop.ap43.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/appleshop.ap43.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location /avito/oauth/callback {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /vk/oauth/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /feeds/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/telegram/file/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # JPEG превью сторис для Instagram Graph API (Meta скачивает image_url)
    location /media/story_previews/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Read-only витрина (Next.js на другом хосте)
    location /api/public/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 404;
    }
}
